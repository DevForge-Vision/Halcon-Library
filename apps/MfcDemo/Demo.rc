#include <afxres.h>
#include <commctrl.h>
#include "resource.h"
IDD_MAIN DIALOGEX 0, 0, 700, 460
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "GlimHalcon SDK 0.0.2 - Image Inspector"
FONT 9, "Segoe UI"
BEGIN
 PUSHBUTTON "Open BMP", IDC_BTN_OPEN, 8, 8, 65, 18
 LTEXT "Contrast", -1, 82, 12, 40, 10
 EDITTEXT IDC_EDIT_THRESHOLD, 123, 8, 35, 18, ES_AUTOHSCROLL
 LTEXT "Min area", -1, 165, 12, 40, 10
 EDITTEXT IDC_EDIT_AREA, 206, 8, 35, 18, ES_AUTOHSCROLL
 LTEXT "Gap", -1, 248, 12, 25, 10
 EDITTEXT IDC_EDIT_GAP, 275, 8, 35, 18, ES_AUTOHSCROLL
 LTEXT "Across", -1, 318, 12, 35, 10
 EDITTEXT IDC_EDIT_OFFSET, 355, 8, 35, 18, ES_AUTOHSCROLL
 PUSHBUTTON "Analyze", IDC_BTN_RUN, 400, 8, 65, 18
 COMBOBOX IDC_MODE, 480, 8, 110, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Original BMP", -1, 8, 34, 120, 12
 LTEXT "Selected mask (exact pixels)", -1, 353, 34, 200, 12
 CONTROL "", IDC_ORIGINAL, "Static", SS_BLACKRECT, 8, 49, 337, 230
 CONTROL "", IDC_MASK, "Static", SS_BLACKRECT, 353, 49, 337, 230
 CONTROL "", IDC_LIST_RESULTS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 8, 288, 682, 140
 LTEXT "Open a BMP. Bright / LocalMean / vertical grouping.", IDC_STATUS, 8, 435, 680, 18
END


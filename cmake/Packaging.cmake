if(CMAKE_SIZEOF_VOID_P EQUAL 8)
	set(GLIM_SDK_ARCH "x64")
else()
	set(GLIM_SDK_ARCH "x86")
endif()
if(MSVC)
	set(GLIM_SDK_TOOLSET "v${MSVC_TOOLSET_VERSION}")
else()
	set(GLIM_SDK_TOOLSET "${CMAKE_CXX_COMPILER_ID}")
endif()
if(GLIM_HALCON_BUILD_SHARED)
	set(GLIM_SDK_KIND "shared")
else()
	set(GLIM_SDK_KIND "static")
endif()
set(GLIM_SDK_VARIANT "${GLIM_SDK_ARCH}/${GLIM_SDK_TOOLSET}/${GLIM_SDK_KIND}")
set_target_properties(GlimHalcon PROPERTIES DEBUG_POSTFIX "d")
install(TARGETS GlimHalcon
	RUNTIME DESTINATION "bin/${GLIM_SDK_VARIANT}/$<CONFIG>"
	LIBRARY DESTINATION "bin/${GLIM_SDK_VARIANT}/$<CONFIG>"
	ARCHIVE DESTINATION "lib/${GLIM_SDK_VARIANT}/$<CONFIG>")
install(FILES ${GLIM_HALCON_PUBLIC_HEADERS} DESTINATION include)
install(FILES examples/06_image_blobs.cpp DESTINATION examples)
install(FILES examples/07_api_contract.cpp DESTINATION examples)
install(FILES README.md DESTINATION .)
install(FILES docs/API_REFERENCE.md docs/TOOLSET_GUIDE.md DESTINATION docs)
install(FILES docs/12_V002_REGRESSION.md DESTINATION docs)
install(FILES docs/11_TOOLSET_VERIFICATION.md docs/02_DEFINITIONS.md docs/05_USER_GUIDE.md DESTINATION docs)
install(FILES docs/releases/${PROJECT_VERSION}.md DESTINATION docs RENAME RELEASE_NOTES.md)
install(FILES docs/06_STAGE1_SOURCE_REVIEW.md docs/07_RELEASE_WORKFLOW.md DESTINATION docs)
install(FILES docs/08_STAGE2_API_ABI_REVIEW.md docs/09_MFC_DEMO.md docs/10_EXECUTION_VERIFICATION.md DESTINATION docs)
if(GLIM_HALCON_BUILD_MFC_DEMO)
	install(TARGETS GlimMfcDemo RUNTIME DESTINATION "bin/${GLIM_SDK_VARIANT}/$<CONFIG>")
	install(DIRECTORY apps/MfcDemo/ DESTINATION examples/MfcDemo)
endif()

option(GLIM_HALCON_ENABLE_PACKAGING "Enable ZIP and Windows NSIS SDK packages" OFF)
if(GLIM_HALCON_ENABLE_PACKAGING)
	if(NOT WIN32 OR NOT MSVC OR NOT GLIM_HALCON_BUILD_SHARED)
		message(FATAL_ERROR "Installer requires Windows MSVC and GLIM_HALCON_BUILD_SHARED=ON")
	endif()
	# Package the compiler's release CRT app-locally beside the DLL.
	# Debug CRT is deliberately excluded and not redistributable.
	set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION "bin/${GLIM_SDK_VARIANT}/Release")
	set(CMAKE_INSTALL_DEBUG_LIBRARIES OFF)
	set(CMAKE_INSTALL_UCRT_LIBRARIES ON)
	set(CMAKE_INSTALL_MFC_LIBRARIES ${GLIM_HALCON_BUILD_MFC_DEMO})
	include(InstallRequiredSystemLibraries)
	if(NOT CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
		message(FATAL_ERROR "Release CRT redistributables were not found; refusing an incomplete SDK package")
	endif()
	foreach(runtime IN LISTS CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
		if(NOT EXISTS "${runtime}")
			message(FATAL_ERROR "Missing runtime: ${runtime}")
		endif()
	endforeach()
	if(GLIM_HALCON_BUILD_MFC_DEMO)
		set(hasMultibyteMfc OFF)
		foreach(runtime IN LISTS CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
			if(runtime MATCHES "/mfc[0-9]+\\.dll$")
				set(hasMultibyteMfc ON)
			endif()
		endforeach()
		if(NOT hasMultibyteMfc)
			message(FATAL_ERROR "Multibyte MFC redistributable missing")
		endif()
	endif()
	set(CPACK_VERBATIM_VARIABLES YES)
	set(CPACK_GENERATOR "ZIP;NSIS")
	set(CPACK_PACKAGE_NAME "GlimHalconSDK")
	set(CPACK_PACKAGE_VENDOR "DevForge-Vision")
	set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
	set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "C++ image-to-blob feature SDK")
	set(CPACK_PACKAGE_FILE_NAME "GlimHalconSDK-${PROJECT_VERSION}-${GLIM_SDK_ARCH}-${GLIM_SDK_TOOLSET}")
	set(CPACK_PACKAGE_INSTALL_DIRECTORY "GlimHalconSDK\\${PROJECT_VERSION}\\${GLIM_SDK_ARCH}-${GLIM_SDK_TOOLSET}")
	set(CPACK_NSIS_DISPLAY_NAME "GlimHalcon SDK ${PROJECT_VERSION} (${GLIM_SDK_ARCH}, ${GLIM_SDK_TOOLSET})")
	set(CPACK_NSIS_PACKAGE_NAME "${CPACK_NSIS_DISPLAY_NAME}")
	set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
	set(CPACK_NSIS_MODIFY_PATH OFF)
	set(CPACK_PACKAGE_INSTALL_REGISTRY_KEY "GlimHalconSDK-${PROJECT_VERSION}-${GLIM_SDK_ARCH}-${GLIM_SDK_TOOLSET}")
	if(GLIM_SDK_ARCH STREQUAL "x64")
		set(CPACK_NSIS_INSTALL_ROOT "$PROGRAMFILES64")
	else()
		set(CPACK_NSIS_INSTALL_ROOT "$PROGRAMFILES")
	endif()
	set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/PackageConfig.cmake")
	include(CPack)
endif()
